# ===========================================================================
# 环境变量模板 → 复制成 /opt/couple-nest/couple-nest.env 并 chmod 600
# 这个文件是唯一的密钥来源，绝不提交到 git
# ===========================================================================

# MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=couple_nest
MYSQL_USERNAME=couplenest
MYSQL_PASSWORD=改成你的强密码

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=5
REDIS_PASSWORD=

# 微信小程序（公众平台 → 开发设置）
WECHAT_APPID=wx改成你的appid
WECHAT_SECRET=改成你的appsecret
WECHAT_MOCK=false

# JWT 密钥：必须 >= 32 字节（HS256 要求 256 bit），缺失或过短应用会启动失败
# 生成：openssl rand -base64 48
JWT_SECRET=用上面的命令生成后粘贴到这里
JWT_EXPIRE_DAYS=7

# 阿里云 OSS（图片上传，可留空：留空时应用照常启动，只是上传接口返回「未配置」）
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_ACCESS_KEY_ID=改成你的AK
OSS_ACCESS_KEY_SECRET=改成你的SK
OSS_BUCKET_NAME=改成你的bucket
