<view class="nav-bar {{transparent ? 'nav-transparent' : ''}}" style="padding-top: {{statusBarHeight}}px; height: {{statusBarHeight + navBarHeight}}px;">
  <view class="nav-bar-inner" style="height: {{navBarHeight}}px;">
    <view class="nav-left" wx:if="{{showBack}}" bindtap="onBack">
      <text class="back-icon">‹</text>
    </view>
    <view class="nav-left nav-left-placeholder" wx:else></view>
    <view class="nav-title">{{title}}</view>
    <view class="nav-right">
      <slot name="right"></slot>
    </view>
  </view>
</view>
<view class="nav-bar-placeholder" style="height: {{statusBarHeight + navBarHeight}}px;"></view>
