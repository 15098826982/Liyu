/* components/top-bar/index.wxss  顶部信息栏样式 - 蓝粉浪漫梦幻风 */
.topbar {
  position: relative;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
  box-shadow: 0 8rpx 30rpx rgba(186, 104, 200, 0.15);
  margin-bottom: 24rpx;
  overflow: hidden;
  background-size: cover;
  background-position: center;
}

/* 有封面图时加半透明遮罩保证文字可读 */
.topbar.has-cover .topbar-num,
.topbar.has-cover .topbar-label,
.topbar.has-cover .topbar-emoji {
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(186, 104, 200, 0.4);
}

.topbar-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, rgba(186, 104, 200, 0.35), rgba(186, 104, 200, 0.15));
  z-index: 0;
}

/* 探针：1px 不可见，仅用于触发 binderror 探测封面 URL 是否失效 */
.topbar-probe {
  position: absolute;
  top: 0;
  left: 0;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.topbar-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.topbar-emoji {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.topbar-text {
  display: flex;
  align-items: baseline;
}

.topbar-num {
  font-size: 38rpx;
  font-weight: 700;
  color: #BA68C8;
  margin-right: 6rpx;
}

.topbar-label {
  font-size: 22rpx;
  color: #8D9AA8;
}

.topbar-divider {
  width: 1rpx;
  height: 36rpx;
  background: rgba(206, 147, 216, 0.5);
  position: relative;
  z-index: 1;
}

.topbar.has-cover .topbar-divider {
  background: rgba(255, 255, 255, 0.5);
}
