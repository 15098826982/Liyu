/* pages/agreement/user-agreement.wxss 用户协议页（蓝粉浪漫风） */
.agree-page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  font-family: "PingFang SC", "Helvetica Neue", sans-serif;
  position: relative;
}

.agree-scroll {
  flex: 1;
  height: 0;
  box-sizing: border-box;
}

.agree-card {
  margin: 20px 20px 30px;
  padding: 28px 20px 20px;
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 24px;
  box-shadow: 0 4px 20px rgba(186, 104, 200, 0.15);
  box-sizing: border-box;
}

.doc-title {
  font-size: 18px;
  font-weight: 700;
  color: #BA68C8;
  text-align: center;
  margin-bottom: 12px;
}

.doc-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 12px;
  color: #8D9AA8;
  line-height: 1.8;
  margin-bottom: 16px;
}

.doc-para {
  font-size: 14px;
  color: #37474F;
  line-height: 1.8;
  margin-bottom: 10px;
  text-align: justify;
}

.sec-title {
  font-size: 16px;
  font-weight: 700;
  color: #BA68C8;
  margin: 22px 0 10px;
}
