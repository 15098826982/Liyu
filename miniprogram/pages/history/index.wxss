/* pages/history/index.wxss  历史（蓝粉浪漫风） */
.container {
  position: relative;
  z-index: 5;
}

.date-group { margin-bottom: 24rpx; }
.date-title {
  font-size: 26rpx; color: rgba(255, 255, 255, 0.85);
  padding: 0 8rpx 12rpx;
}
.order-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16rpx 0; border-bottom: 1rpx solid rgba(186, 104, 200, 0.15);
}
.order-row:last-child { border-bottom: none; }
.dish-row { display: flex; align-items: center; gap: 12rpx; }
.dish-name { font-size: 28rpx; }
.order-by { font-size: 22rpx; color: #8D9AA8; margin-top: 6rpx; }
.order-info { flex: 1; }
.status { font-size: 24rpx; }
.status-done { color: #FF80AB; }
.status-pending { color: #BA68C8; }
.loading-more { text-align: center; color: rgba(255, 255, 255, 0.7); font-size: 24rpx; padding: 30rpx 0; }

/* 漂浮装饰 */
.deco {
  position: absolute;
  z-index: 0;
  pointer-events: none;
}
.deco-heart1 { top: 14%; right: 8%; font-size: 22px; animation: floatY 3s ease-in-out infinite; }
.deco-star1 { top: 20%; left: 10%; font-size: 16px; animation: twinkle 2s ease-in-out infinite; }
.deco-cloud1 { top: 12%; left: 30%; font-size: 26px; opacity: 0.7; animation: cloudMove 5s ease-in-out infinite; }
@keyframes floatY { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
@keyframes twinkle { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.8); } }
@keyframes cloudMove { 0%, 100% { transform: translateX(0); } 50% { transform: translateX(10px); } }
