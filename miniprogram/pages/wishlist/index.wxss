/* pages/wishlist/index.wxss  蓝粉浪漫梦幻风 */

/* 蓝粉渐变背景 */
.notebook-bg {
  min-height: 100vh;
}

.page {
  position: relative;
  overflow: hidden;
  font-family: "Comic Sans MS", "Marker Felt", "STKaiti", "KaiTi", "PingFang SC", sans-serif;
}

.content {
  position: relative;
  z-index: 5;
  padding: 0 32rpx 80rpx;
}

/* ============ 漂浮装饰 ============ */
.deco { position: absolute; z-index: 0; pointer-events: none; }
.deco-heart1 { top: 14%; right: 8%; font-size: 22px; animation: floatY 3s ease-in-out infinite; }
.deco-star1 { top: 20%; left: 10%; font-size: 16px; animation: twinkle 2s ease-in-out infinite; }
.deco-cloud1 { top: 12%; left: 30%; font-size: 26px; opacity: 0.7; animation: cloudMove 5s ease-in-out infinite; }
@keyframes floatY { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
@keyframes twinkle { 0%,100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.8); } }
@keyframes cloudMove { 0%,100% { transform: translateX(0); } 50% { transform: translateX(10px); } }

/* ============ 右下角悬浮添加按钮 ============ */
.wl-fab {
  position: fixed;
  right: 50rpx;
  bottom: 70rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #CE93D8 0%, #BA68C8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 4rpx 0 #8E24AA,
    0 8rpx 20rpx rgba(186, 104, 200, 0.5);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  z-index: 60;
  transition: transform 0.15s ease;
}
.wl-fab.tap-active {
  transform: scale(0.9) translateY(2rpx);
  box-shadow:
    0 2rpx 0 #8E24AA,
    0 4rpx 12rpx rgba(186, 104, 200, 0.4);
}
.wl-fab-icon {
  font-size: 60rpx;
  color: #fff;
  font-weight: 300;
  line-height: 1;
}

/* ============ 标题区 ============ */
.wl-title {
  text-align: center;
  padding: 20rpx 0 24rpx;
  transform: rotate(-0.5deg);
}
.wl-title-main {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.wl-title-icon {
  font-size: 44rpx;
}
.wl-title-text {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  text-shadow: 0 2rpx 8rpx rgba(186, 104, 200, 0.45);
}
.wl-title-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  letter-spacing: 2rpx;
}

/* ============ 分类Tab ============ */
.wl-tabs {
  display: flex;
  white-space: nowrap;
  padding: 8rpx 0 24rpx;
  gap: 24rpx;
}
.wl-tab {
  display: inline-block;
  padding: 12rpx 4rpx;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
  font-weight: 500;
  position: relative;
  margin-right: 24rpx;
}
.wl-tab::after {
  content: '';
  position: absolute;
  left: 50%;
  right: 50%;
  bottom: 4rpx;
  height: 4rpx;
  background: #FF80AB;
  border-radius: 2rpx;
  transition: left 0.2s ease, right 0.2s ease;
}
.wl-tab-active {
  color: #fff;
  font-weight: 700;
  text-shadow: 0 1px 6px rgba(186, 104, 200, 0.5);
}
.wl-tab-active::after {
  left: 0;
  right: 0;
}

/* ============ 心愿卡片 ============ */
.wl-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.wl-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(186, 104, 200, 0.15);
}
.wl-card-done {
  background: rgba(255, 240, 246, 0.92);
  border: 2rpx solid #FF80AB;
  box-shadow: 0 8rpx 30rpx rgba(240, 98, 146, 0.3);
}
.wl-card-done .wl-card-title {
  color: #8D9AA8;
}

/* 第一行 */
.wl-row1 {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}
.wl-thumb {
  width: 130rpx;
  height: 130rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1px solid rgba(255, 255, 255, 0.6);
}
.wl-thumb-emoji {
  font-size: 64rpx;
  line-height: 1;
}
.wl-thumb-img {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}
.wl-info {
  flex: 1;
  min-width: 0;
}
.wl-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #37474F;
  line-height: 1.3;
  word-break: break-all;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.wl-creator {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 10rpx;
}
.wl-creator-avatar {
  font-size: 30rpx;
  line-height: 1;
}
.wl-creator-text {
  font-size: 24rpx;
  color: #8D9AA8;
}

/* 状态标签 */
.wl-status {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}
.wl-status-icon {
  font-size: 22rpx;
}
.wl-status-todo {
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(141, 154, 168, 0.35);
  color: #8D9AA8;
}
.wl-status-buying {
  background: #FCE4EC;
  color: #BA68C8;
}
.wl-status-done {
  background: linear-gradient(135deg, #FF80AB 0%, #F06292 100%);
  color: #fff;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(240, 98, 146, 0.35);
}

/* 预算 */
.wl-budget {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 14rpx;
}
.wl-budget-icon {
  font-size: 26rpx;
}
.wl-budget-text {
  font-size: 28rpx;
  color: #F06292;
  font-weight: 700;
}

/* 描述 */
.wl-desc {
  font-size: 26rpx;
  color: #8D9AA8;
  line-height: 1.5;
  margin-bottom: 18rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 去购买按钮 */
.wl-link-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 10rpx 26rpx;
  margin-bottom: 18rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #CE93D8 0%, #BA68C8 100%);
  box-shadow: 0 6rpx 16rpx rgba(186, 104, 200, 0.3);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
}
.wl-link-icon {
  font-size: 24rpx;
}
.wl-link-text {
  font-size: 26rpx;
  color: #fff;
  font-weight: 700;
}

/* 操作行 */
.wl-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 20rpx;
  padding-top: 16rpx;
  border-top: 1px dashed rgba(186, 104, 200, 0.2);
}
.wl-status-picker {
  margin-right: auto;
}
.wl-picker-inner {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: rgba(255, 255, 255, 0.7);
  border: 1px solid rgba(186, 104, 200, 0.25);
  border-radius: 16rpx;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  color: #37474F;
}
.wl-picker-arrow {
  font-size: 22rpx;
  color: #8D9AA8;
}
.wl-act-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* ============ 空状态 ============ */
.wl-empty {
  text-align: center;
  padding: 100rpx 40rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 32rpx;
  border: 1px solid rgba(255, 255, 255, 0.5);
  margin-top: 20rpx;
}
.wl-empty-emoji {
  font-size: 96rpx;
  margin-bottom: 20rpx;
}
.wl-empty-title {
  font-size: 32rpx;
  color: #37474F;
  font-weight: 600;
  margin-bottom: 12rpx;
}
.wl-empty-sub {
  font-size: 26rpx;
  color: #8D9AA8;
}

/* ============ 弹窗表单 ============ */
.wl-form {
  padding: 56rpx 36rpx 60rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 40rpx 40rpx 0 0;
}
.wl-form-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #37474F;
  text-align: center;
  margin-bottom: 40rpx;
  letter-spacing: 2rpx;
}
.wl-form-row {
  margin-bottom: 32rpx;
}
.wl-form-label {
  font-size: 26rpx;
  color: #8D9AA8;
  margin-bottom: 16rpx;
  font-weight: 500;
  line-height: 1.4;
}
.wl-form-input {
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(186, 104, 200, 0.25);
  border-radius: 16rpx;
  padding: 24rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
  height: 80rpx;
  color: #37474F;
  box-sizing: border-box;
}
.wl-ph {
  color: #B0BEC5;
  line-height: 1.5;
}

/* 上传照片按钮 */
.wl-upload-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1px dashed rgba(240, 98, 146, 0.5);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}
.wl-upload-icon {
  font-size: 36rpx;
}
.wl-upload-text {
  font-size: 26rpx;
  color: #F06292;
}

/* 照片预览 */
.wl-photo-preview {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.wl-photo-img {
  width: 180rpx;
  height: 180rpx;
  border-radius: 16rpx;
  border: 1px solid rgba(255, 255, 255, 0.6);
}
.wl-photo-actions {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}
.wl-photo-btn {
  padding: 14rpx 28rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(240, 98, 146, 0.4);
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #F06292;
}
.wl-photo-clear {
  border-color: rgba(186, 104, 200, 0.3);
  color: #8D9AA8;
}

/* 图标网格 */
.wl-icon-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 14rpx;
}
.wl-icon-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 14rpx 4rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(186, 104, 200, 0.2);
  border-radius: 16rpx;
  transition: all 0.15s ease;
}
.wl-icon-emoji {
  font-size: 40rpx;
  line-height: 1;
}
.wl-icon-label {
  font-size: 20rpx;
  color: #8D9AA8;
  margin-top: 6rpx;
}
.wl-icon-active {
  background: #FCE4EC;
  border-color: #F06292;
  box-shadow: 0 2rpx 10rpx rgba(240, 98, 146, 0.25);
}
.wl-icon-active .wl-icon-label {
  color: #F06292;
  font-weight: 600;
}

/* chips */
.wl-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.wl-chip {
  padding: 12rpx 28rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1px solid rgba(186, 104, 200, 0.25);
  border-radius: 28rpx;
  font-size: 26rpx;
  color: #8D9AA8;
  transition: all 0.15s ease;
}
.wl-chip-active {
  background: #FF80AB;
  border-color: #FF80AB;
  color: #fff;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(255, 128, 171, 0.35);
}

/* 提交按钮 */
.wl-form-submit {
  margin-top: 16rpx;
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #CE93D8 0%, #BA68C8 100%);
  color: #fff;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 0;
  border: none;
  letter-spacing: 2rpx;
  box-shadow: 0 6rpx 20rpx rgba(186, 104, 200, 0.35);
}
.wl-form-submit::after {
  border: none;
}
.wl-form-submit[disabled] {
  background: #E1BEE7;
  color: #fff;
}

/* ============ 交互动画 ============ */
.tap-feedback.tap-active,
.tap-feedback:active {
  transform: scale(0.95) !important;
  background-color: rgba(186, 104, 200, 0.08) !important;
  box-shadow: 0 1rpx 6rpx rgba(186, 104, 200, 0.15) !important;
}
.wl-card.list-enter {
  animation: cardFadeIn 0.3s ease-out both;
}
@keyframes cardFadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to   { opacity: 1; transform: translateY(0); }
}
.wl-pop {
  position: fixed;
  top: 50%;
  left: 50%;
  font-size: 140rpx;
  z-index: 999;
  pointer-events: none;
  animation: popCheckin 0.6s ease-out forwards;
}
@keyframes popCheckin {
  0%   { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  40%  { transform: translate(-50%, -50%) scale(1.2); opacity: 1; }
  70%  { transform: translate(-50%, -50%) scale(1); opacity: 1; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 0; }
}
