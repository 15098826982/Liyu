<page-bg />
<view class="page page-enter notebook-bg">
  <nav-bar title="" transparent />

  <!-- 漂浮装饰 -->
  <view class="deco deco-heart1">💕</view>
  <view class="deco deco-star1">✨</view>
  <view class="deco deco-cloud1">☁️</view>

  <view class="content">
    <!-- 顶部日期 + 切换 -->
    <view class="nb-header">
      <view class="nb-nav-btn" bindtap="onPrevMonth">‹</view>
      <view class="nb-date">
        <view class="nb-month">{{calendarMonthText}}</view>
        <view class="nb-year">{{calendarYearText}}</view>
      </view>
      <view class="nb-nav-btn" bindtap="onNextMonth">›</view>
    </view>

    <!-- 说明文字 -->
    <view class="nb-note">方的是老公 圆的是老婆</view>

    <!-- 日历 -->
    <view class="nb-calendar">
      <view class="nb-weekdays">
        <text class="nb-wd" wx:for="{{weekdays}}" wx:key="*this">{{item}}</text>
      </view>

      <view class="nb-grid">
        <view class="nb-cell {{item.empty ? 'nb-empty' : ''}}"
              wx:for="{{calendarDays}}" wx:key="index">
          <block wx:if="{{!item.empty}}">
            <view class="nb-date-row">
              <text class="nb-date">{{item.date}}</text>
              <text class="nb-today-tag" wx:if="{{item.isToday}}">今天</text>
            </view>
            <view class="nb-moods">
              <!-- 老公方形 -->
              <view class="nb-mood nb-mood-husband" wx:if="{{item.husbandImg}}"
                    style="background: {{item.husbandColor}}">
                <image src="{{item.husbandImg}}" mode="aspectFit" style="width:100%;height:100%;display:block;" />
              </view>
              <!-- 老婆圆形 -->
              <view class="nb-mood nb-mood-wife" wx:if="{{item.wifeImg}}"
                    style="background: {{item.wifeColor}}">
                <image src="{{item.wifeImg}}" mode="aspectFit" style="width:100%;height:100%;display:block;" />
              </view>
            </view>
          </block>
        </view>
      </view>
    </view>

    <!-- 今日心情 -->
    <view class="nb-today">
      <view class="nb-today-title">今日心情</view>
      <view class="nb-today-row">
        <view class="nb-today-item">
          <view class="nb-avatar nb-avatar-wife">
            <image wx:if="{{wifeMood.mood}}" class="nb-avatar-emoji" src="{{wifeMood.moodImg}}" mode="aspectFit" style="width:100%;height:100%;display:block;" />
            <text wx:else class="nb-avatar-emoji">👩</text>
          </view>
          <view class="nb-today-name">老婆</view>
          <view class="nb-today-mood" wx:if="{{wifeMood.mood}}">{{wifeMood.mood}}</view>
          <view class="nb-today-empty" wx:else>未打卡</view>
        </view>

        <view class="nb-heart">💕</view>

        <view class="nb-today-item">
          <view class="nb-avatar nb-avatar-husband">
            <image wx:if="{{husbandMood.mood}}" class="nb-avatar-emoji" src="{{husbandMood.moodImg}}" mode="aspectFit" style="width:100%;height:100%;display:block;" />
            <text wx:else class="nb-avatar-emoji">👨</text>
          </view>
          <view class="nb-today-name">老公</view>
          <view class="nb-today-mood" wx:if="{{husbandMood.mood}}">{{husbandMood.mood}}</view>
          <view class="nb-today-empty" wx:else>未打卡</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 手绘铅笔按钮 -->
  <view class="nb-fab" bindtap="onEditMood">
    <text class="nb-fab-icon">✏️</text>
  </view>
</view>
